ExecutePython�{"code": "# 分析朋友关系数据\nfriend_data = [\n    {\"userid\": 13, \"friendid\": 15},\n    {\"userid\": 13, \"friendid\": 21},\n    {\"userid\": 16, \"friendid\": 25},\n    {\"userid\": 21, \"friendid\": 13},\n    {\"userid\": 21, \"friendid\": 15}\n]\n\n# 用户ID到姓名的映射\nuser_mapping = {\n    13: \"zhang san\",\n    15: \"li si\",\n    16: \"liu shuo\",\n    21: \"gao yang\",\n    25: \"未知用户\"  # 这个ID在user表中没有找到\n}\n\nprint(\"=== 朋友关系分析 ===\")\nprint()\n\n# 显示每个用户的朋友\nfriends_by_user = {}\nfor rel in friend_data:\n    user_id = rel[\"userid\"]\n    friend_id = rel[\"friendid\"]\n    \n    user_name = user_mapping.get(user_id, f\"用户{user_id}\")\n    friend_name = user_mapping.get(friend_id, f\"用户{friend_id}\")\n    \n    if user_name not in friends_by_user:\n        friends_by_user[user_name] = []\n    friends_by_user[user_name].append(friend_name)\n\nprint(\"每个用户的朋友列表：\")\nfor user, friends in sorted(friends_by_user.items()):\n    print(f\"{user} 的朋友：{', '.join(friends)}\")\n\nprint()\nprint(\"=== 双向朋友关系 ===\")\n\n# 检查双向关系（互相加为好友）\nbidirectional_pairs = set()\nfor rel1 in friend_data:\n    for rel2 in friend_data:\n        if (rel1[\"userid\"] == rel2[\"friendid\"] and \n            rel1[\"friendid\"] == rel2[\"userid\"]):\n            # 创建排序后的元组，避免重复\n            pair = tuple(sorted([rel1[\"userid\"], rel1[\"friendid\"]]))\n            bidirectional_pairs.add(pair)\n\nif bidirectional_pairs:\n    for pair in bidirectional_pairs:\n        user1_name = user_mapping.get(pair[0], f\"用户{pair[0]}\")\n        user2_name = user_mapping.get(pair[1], f\"用户{pair[1]}\")\n        print(f\"{user1_name} 和 {user2_name} 是双向好友（互相加为好友）\")\nelse:\n    print(\"没有发现双向好友关系\")\n\nprint()\nprint(\"=== 单向朋友关系 ===\")\n# 找出单向关系\nall_relationships = [(rel[\"userid\"], rel[\"friendid\"]) for rel in friend_data]\nfor user_id, friend_id in all_relationships:\n    if (friend_id, user_id) not in all_relationships:\n        user_name = user_mapping.get(user_id, f\"用户{user_id}\")\n        friend_name = user_mapping.get(friend_id, f\"用户{friend_id}\")\n        print(f\"{user_name} 单向添加了 {friend_name} 为好友\")"}
